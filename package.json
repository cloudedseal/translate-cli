{
  "name": "@cloudedseal/translate-cli",
  "version": "1.0.0",
  "description": "CLI to list all meanings of an English word from the Collins dictionary (phonetics, POS tags, examples, phrases)",
  "type": "module",
  "bin": {
    "translate": "bin/translate.js"
  },
  "files": [
    "bin",
    "lib"
  ],
  "scripts": {
    "start": "node bin/translate.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudedseal/translate-cli.git"
  },
  "homepage": "https://github.com/cloudedseal/translate-cli#readme",
  "bugs": {
    "url": "https://github.com/cloudedseal/translate-cli/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cli",
    "dictionary",
    "collins",
    "youdao",
    "translate",
    "meaning",
    "english"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT"
}
